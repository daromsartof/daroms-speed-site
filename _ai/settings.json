{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm dss:*)",
      "Bash(node core/cli/dss.ts:*)",
      "Bash(pnpm install)",
      "Bash(pnpm build)",
      "Bash(pnpm start:*)",
      "Bash(pnpm cf:build)",
      "Bash(pnpm exec wrangler deploy --dry-run:*)",
      "Bash(npx -y lighthouse@13:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec prettier:*)",
      "Bash(pnpm exec next typegen)",
      "Bash(pnpm test)",
      "Bash(node --test:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(python3 .claude/hooks/dss-context.py test:*)",
      "Bash(python3 .claude/hooks/dss-check-rules.py --all)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Read(./core/CATALOG.md)",
      "Read(./site.spec.md)",
      "Read(./.claude-context/**)",
      "Read(./.dss/inspiration/**)",
      "WebSearch",
      "WebFetch(domain:dribbble.com)",
      "WebFetch(domain:www.behance.net)",
      "WebFetch(domain:www.awwwards.com)",
      "WebFetch(domain:www.siteinspire.com)",
      "WebFetch(domain:godly.website)",
      "WebFetch(domain:land-book.com)",
      "WebFetch(domain:www.lapa.ninja)",
      "WebFetch(domain:fonts.google.com)",
      "Read(~/.dss/brain/**)",
      "Edit(~/.dss/brain/**)",
      "Write(~/.dss/brain/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./.dev.vars)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./.dev.vars)",
      "Edit(./core/**)",
      "Write(./core/**)",
      "Edit(./app/theme.css)",
      "Edit(./app/fonts.ts)",
      "Edit(./app/theme.ts)",
      "Edit(./content/meta.ts)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)"
    ],
    "additionalDirectories": ["~/.dss/brain"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/core/_ai/hooks/dss-sync.py\"",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dss-context.py\" build",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dss-context.py\" route",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dss-check-rules.py\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dss-deny-env.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dss-typecheck.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dss-session-stats.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "skillOverrides": {
    "frontend-design": "name-only",
    "vercel-react-best-practices": "name-only",
    "vercel-composition-patterns": "name-only",
    "vercel-react-view-transitions": "name-only",
    "web-design-guidelines": "name-only",
    "wq-core-web-vitals": "name-only",
    "wq-performance": "name-only",
    "ecc-tdd-workflow": "name-only",
    "ecc-security-review": "name-only",
    "ecc-accessibility": "name-only",
    "ecc-typescript-patterns": "name-only"
  }
}
