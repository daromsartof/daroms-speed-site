{
  "name": "@dss/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM: SQLite (Cloudflare D1 binding, libSQL) with one schema, or Postgres (postgres.js). Added to a site by `dss db init`.",
  "exports": {
    ".": "./src/index.ts",
    "./pg": "./src/pg-columns.ts",
    "./d1": "./src/d1.ts",
    "./libsql": "./src/libsql.ts",
    "./postgres": "./src/postgres.ts",
    "./config": "./src/drizzle-config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.17",
    "@opennextjs/cloudflare": ">=1.20",
    "server-only": "*",
    "postgres": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "@opennextjs/cloudflare": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "postgres": "4.1.1"
  }
}
