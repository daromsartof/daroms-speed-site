{
  "name": "@dss/data",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle ORM on SQLite: Cloudflare D1 in production on Workers, libSQL/SQLite elsewhere, one schema. Postgres comes as a separate entry. Added to a site by `dss db init`.",
  "exports": {
    ".": "./src/index.ts",
    "./d1": "./src/d1.ts",
    "./libsql": "./src/libsql.ts",
    "./config": "./src/drizzle-config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "peerDependencies": {
    "@libsql/client": ">=0.17",
    "@opennextjs/cloudflare": ">=1.20",
    "server-only": "*"
  },
  "peerDependenciesMeta": {
    "@libsql/client": {
      "optional": true
    },
    "@opennextjs/cloudflare": {
      "optional": true
    }
  },
  "devDependencies": {
    "@libsql/client": "0.18.0"
  }
}
