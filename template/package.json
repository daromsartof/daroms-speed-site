{
  "name": "dss-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "docker:build": "docker build -t dss-site .",
    "dss": "node core/cli/dss.ts"
  },
  "dependencies": {
    "@dss/aimkit": "workspace:*",
    "@dss/design": "workspace:*",
    "@dss/motion": "workspace:*",
    "@dss/security": "workspace:*",
    "@dss/seo": "workspace:*",
    "@dss/site": "workspace:*",
    "@dss/ui": "workspace:*",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@dss/config": "workspace:*",
    "@eslint/js": "9.39.5",
    "@opennextjs/cloudflare": "1.20.17",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "wrangler": "4.161.0"
  }
}
