{
  "name": "@daromsart/daroms-speed-site",
  "version": "0.1.0",
  "description": "Next.js website framework built for Claude Code: design DNA, sections, SEO, security, data, deploy adapters, the dss CLI and a low-token AI layer to produce varied, production-grade sites on a line.",
  "license": "MIT",
  "author": "Daroms'Art (https://daromsart.xyz/)",
  "homepage": "https://daromsartof.github.io/daroms-speed-site/",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daromsartof/daroms-speed-site.git"
  },
  "bugs": {
    "url": "https://github.com/daromsartof/daroms-speed-site/issues"
  },
  "keywords": [
    "nextjs",
    "claude",
    "claude-code",
    "framework",
    "website",
    "cli",
    "seo",
    "tailwindcss",
    "threejs",
    "cloudflare",
    "drizzle",
    "ai",
    "ai-agents",
    "llms-txt",
    "website-generator",
    "starter"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@9.7.0",
  "bin": {
    "dss": "dist/cli/dss.js"
  },
  "files": [
    "dist/cli",
    "cli",
    "!cli/tests",
    "packages",
    "!packages/*/tests",
    "!packages/*/node_modules",
    "modules",
    "registry",
    "template",
    "generators",
    "_ai",
    "!_ai/hooks/tests",
    "scripts",
    "VERSION",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "docs",
    "CATALOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:hooks",
    "format:check": "prettier --check .",
    "build:cli": "node scripts/build-cli.mjs",
    "prepublishOnly": "pnpm check && pnpm build:cli",
    "catalog": "node cli/dss.ts catalog",
    "test:hooks": "python3 -m unittest discover -s _ai/hooks/tests",
    "verify:registry": "node scripts/verify-registry.mjs",
    "docs": "node cli/dss.ts docs"
  },
  "devDependencies": {
    "@dss/config": "workspace:*",
    "@dss/data": "workspace:*",
    "@dss/design": "workspace:*",
    "@dss/motion": "workspace:*",
    "@dss/security": "workspace:*",
    "@dss/seo": "workspace:*",
    "@dss/site": "workspace:*",
    "@dss/three": "workspace:*",
    "@dss/ui": "workspace:*",
    "@eslint/js": "9.39.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "31.0.1",
    "next": "16.4.6",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
