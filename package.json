{
  "name": "@daromsart/daroms-speed-site",
  "version": "0.1.0",
  "description": "Next.js website framework built for Claude Code: design DNA, sections, SEO, security, data, deploy adapters, the dss CLI and a low-token AI layer to produce varied, production-grade sites on a line.",
  "license": "MIT",
  "author": "Daroms",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daromsartof/daroms-speed-site.git"
  },
  "bugs": {
    "url": "https://github.com/daromsartof/daroms-speed-site/issues"
  },
  "keywords": [
    "nextjs",
    "claude",
    "claude-code",
    "framework",
    "website",
    "cli",
    "seo",
    "tailwindcss",
    "threejs",
    "cloudflare",
    "drizzle",
    "ai"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@dss/config": "workspace:*",
    "@dss/design": "workspace:*",
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "next": "16.4.6",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
